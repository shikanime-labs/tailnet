// Tailscale policy file — source of truth for the shikanime tailnet.
// Applied to control by CI (gitops-acl-action). Editing the admin console
// directly makes the next run warn; always re-export before touching this.
{
	"autoApprovers": {
		"routes": {
			"10.244.0.0/16": ["tag:k8s-node"],
			"fd00::/108":    ["tag:k8s-node"],
		},

		"exitNode": ["tag:server"],
		"services": {"svc:nishir": ["tag:k8s-node"]},
	},

	"grants": [
		{
			"src": ["autogroup:it-admin", "tag:workstation"],
			"dst": ["tag:k8s-operator"],
			"app": {
				"tailscale.com/cap/kubernetes": [
					{"impersonate": {"groups": ["system:masters"]}},
				],
			},
		},
		{
			"src": ["autogroup:member"],
			"dst": ["autogroup:self"],

			"app": {
				"tailscale.com/cap/drive": [
					{
						"shares": ["*"],
						"access": "rw",
					},
				],
			},
		},
		{
			"src": ["autogroup:member", "tag:machine"],
			"dst": ["autogroup:member", "tag:machine"],

			"app": {
				"tailscale.com/cap/drive": [
					{
						"shares": ["*"],
						"access": "ro",
					},
				],
			},
		},
		{
			"src": ["autogroup:it-admin", "tag:workstation"],
			"dst": ["autogroup:member", "tag:machine"],

			"app": {
				"tailscale.com/cap/drive": [
					{
						"shares": ["*"],
						"access": "rw",
					},
				],
			},
		},
		{
			"src": ["autogroup:member", "tag:machine"],
			"dst": ["autogroup:internet"],
			"ip":  ["*"],
		},
		{
			"src": ["autogroup:it-admin", "tag:workstation"],
			"dst": ["autogroup:member", "tag:machine", "tag:catbox"],
			"ip":  ["22"],
		},
		{
			"src": ["autogroup:it-admin", "tag:workstation"],
			"dst": ["autogroup:member", "tag:machine", "tag:catbox"],
			"ip":  ["3389"],
		},
		{
			"src": ["autogroup:it-admin", "tag:workstation"],
			"dst": ["autogroup:member", "tag:machine", "tag:catbox"],
			"ip":  ["5900"],
		},
		{
			"src": ["autogroup:it-admin", "tag:workstation"],
			"dst": ["autogroup:member", "tag:automata"],
			"ip":  ["8642"],
		},
		{
			"src": ["autogroup:it-admin", "tag:workstation"],
			"dst": ["autogroup:member", "tag:automata"],
			"ip":  ["9900"],
		},
		{
			"src": ["autogroup:it-admin", "tag:workstation"],
			"dst": ["autogroup:member", "tag:automata"],
			"ip":  ["9119"],
		},
		{
			"src": ["autogroup:it-admin", "tag:workstation"],
			"dst": ["tag:k8s-operator"],
			"ip":  ["443"],
		},
		{
			"src": ["autogroup:member"],
			"dst": [
				"tag:inference",
				"tag:web",
				"tag:authelia",
				"tag:copyparty",
				"tag:forgejo",
				"tag:honcho",
				"tag:immich",
				"tag:jellyfin",
				"tag:llama-cpp",
				"tag:lldap",
				"tag:longhorn",
				"tag:matrix",
				"tag:qbittorrent",
				"tag:radarr",
				"tag:seerr",
				"tag:sonarr",
				"tag:vaultwarden",
				"tag:victoria-logs",
				"tag:victoria-metrics",
			],
			"ip":  ["80", "443"],
		},
		{
			"src": ["autogroup:it-admin", "tag:workstation"],
			"dst": [
				"tag:automata",
				"tag:bazarr",
				"tag:flux-operator",
				"tag:flux-receivers",
				"tag:gitea-mirror",
				"tag:lidarr",
				"tag:maintainerr",
				"tag:metatube",
				"tag:prowlarr",
				"tag:syncthing",
				"tag:telsha-webhook",
				"tag:whisparr",
			],
			"ip":  ["80", "443"],
		},
		{
			"src": ["autogroup:it-admin", "tag:workstation"],
			"dst": ["tag:syncthing"],
			"ip":  ["21027", "22000"],
		},
		{
			"src": ["autogroup:member"],
			"dst": ["tag:bittorrent"],
			"ip":  ["6881"],
		},
		{
			"src": ["autogroup:member"],
			"dst": ["tag:ftp"],
			"ip":  ["21"],
		},
		{
			"src": ["autogroup:member"],
			"dst": ["tag:ftp", "tag:git", "tag:ssh"],
			"ip":  ["22"],
		},
		{
			"src": ["autogroup:member"],
			"dst": ["tag:ftp"],
			"ip":  ["990"],
		},
		{
			"src": ["autogroup:member"],
			"dst": ["tag:ftp"],
			"ip":  ["12000-12099"],
		},
		{
			"src": ["autogroup:member"],
			"dst": ["tag:jellyfin"],
			"ip":  ["1900"],
		},
		{
			"src": ["autogroup:member"],
			"dst": ["tag:jellyfin"],
			"ip":  ["7359"],
		},
		{
			"src": ["autogroup:member"],
			"dst": ["tag:matrix"],
			"ip":  ["8448"],
		},
		{
			"src": ["autogroup:member"],
			"dst": ["tag:workstation"],
			"ip":  ["25565"],
		},
		{
			"src": ["tag:inference"],
			"dst": ["autogroup:member", "tag:workstation"],
			"ip":  ["1234"],
		},
		{
			"src": ["tag:automata"],
			"dst": ["tag:inference"],
			"ip":  ["443"],
		},
		{
			"src": ["tag:automata"],
			"dst": ["tag:automata"],
			"ip":  ["8642"],
		},
		{
			"src": ["tag:automata"],
			"dst": ["tag:automata"],
			"ip":  ["9900"],
		},
		{
			"src": ["tag:machine"],
			"dst": ["tag:machine"],
			"ip":  ["22"],
		},
		{
			"src": ["tag:machine"],
			"dst": ["tag:inference"],
			"ip":  ["443"],
		},
		{
			"src": ["tag:machine"],
			"dst": [
				"tag:authelia",
				"tag:forgejo",
				"tag:lldap",
				"tag:victoria-logs",
				"tag:victoria-metrics",
			],
			"ip":  ["443"],
		},
		{
			"src": ["tag:automata"],
			"dst": ["tag:honcho", "tag:matrix", "tag:web"],
			"ip":  ["443"],
		},
		{
			"src": ["tag:k8s-node", "10.244.0.0/16", "fd00::/108"],
			"dst": ["tag:k8s-node", "10.244.0.0/16", "fd00::/108"],
			"ip":  ["*"],
		},
	],

	"nodeAttrs": [
		{
			"target": ["tag:web"],
			"attr":   ["funnel"],
		},
		{
			"target": ["autogroup:member", "tag:machine"],
			"attr":   ["drive:share", "drive:access"],
		},
		{
			"target": ["100.117.159.56"],
			"attr":   ["mullvad"],
		},
		{
			"target": ["100.77.66.124"],
			"attr":   ["mullvad"],
		},
		{
			"target": ["100.74.220.28"],
			"attr":   ["mullvad"],
		},
	],

	"ssh": [
		{
			"action": "accept",
			"src":    ["autogroup:it-admin", "tag:workstation"],
			"dst":    ["tag:machine", "tag:catbox"],
			"users":  ["autogroup:nonroot", "root"],
		},
		{
			"action": "accept",
			"src":    ["autogroup:member", "tag:machine"],
			"dst":    ["tag:machine"],
			"users":  ["builder"],
		},
		{
			"action": "accept",
			"src":    ["tag:ci"],
			"dst":    ["tag:machine"],
			"users":  ["builder"],
		},
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot"],
		},
	],

	"tagOwners": {
		"tag:inference":         ["autogroup:it-admin", "tag:k8s-operator"],
		"tag:machine":           ["autogroup:it-admin"],
		"tag:server":            ["tag:machine"],
		"tag:workstation":       ["tag:machine"],
		"tag:k8s-node":          ["tag:machine"],
		"tag:k8s-operator":      ["tag:machine"],
		"tag:automata":          ["tag:machine", "tag:k8s-operator"],
		"tag:catbox":            ["tag:k8s-operator"],
		"tag:web":               ["tag:k8s-operator"],
		"tag:authelia":             ["tag:k8s-operator"],
		"tag:bazarr":               ["tag:k8s-operator"],
		"tag:flux-operator":        ["tag:k8s-operator"],
		"tag:flux-receivers":       ["tag:k8s-operator"],
		"tag:forgejo":              ["tag:k8s-operator"],
		"tag:gitea-mirror":         ["tag:k8s-operator"],
		"tag:honcho":               ["tag:k8s-operator"],
		"tag:immich":               ["tag:k8s-operator"],
		"tag:llama-cpp":            ["tag:k8s-operator"],
		"tag:lidarr":               ["tag:k8s-operator"],
		"tag:lldap":                ["tag:k8s-operator"],
		"tag:longhorn":             ["tag:k8s-operator"],
		"tag:maintainerr":          ["tag:k8s-operator"],
		"tag:metatube":             ["tag:k8s-operator"],
		"tag:prowlarr":             ["tag:k8s-operator"],
		"tag:qbittorrent":          ["tag:k8s-operator"],
		"tag:radarr":               ["tag:k8s-operator"],
		"tag:seerr":                ["tag:k8s-operator"],
		"tag:telsha-webhook":       ["tag:k8s-operator"],
		"tag:vaultwarden":          ["tag:k8s-operator"],
		"tag:victoria-logs":        ["tag:k8s-operator"],
		"tag:victoria-metrics":     ["tag:k8s-operator"],
		"tag:whisparr":             ["tag:k8s-operator"],
		"tag:jellyfin":          ["tag:k8s-operator"],
		"tag:deluge":            ["tag:k8s-operator"],
		"tag:sonarr":            ["tag:k8s-operator"],
		"tag:copyparty":         ["tag:k8s-operator"],
		"tag:bittorrent":        ["tag:k8s-operator"],
		"tag:matrix":            ["tag:k8s-operator"],
		"tag:syncthing":         ["tag:k8s-operator"],
		"tag:git":               ["tag:k8s-operator"],
		"tag:ftp":               ["tag:k8s-operator"],
		"tag:ssh":               ["tag:k8s-operator"],
		"tag:ci":                ["tag:machine"],
	},

	// CI-enforced zero-trust invariants. These deny tests assert that the
	// broad allow-list grants above do NOT leak into sensitive scopes. If a
	// future edit accidentally widens access, the `test` job fails before apply.
	//
	// Tailscale `tests` reject autogroups as `src` (FR tailscale/tailscale#4416),
	// so roles are represented by concrete stand-in identities:
	//   - member path: member.example@shikanime.studio (a neutral placeholder)
	//   - it-admin path: shikanime.deva@gmail.com (the owner identity)
	// Assert only what the grants actually allow/deny; see docs/Network-Boundaries.md.
	"tests": [
		// --- autogroup:member path (stand-in: a neutral member identity) ---
		{
			// Members never reach the Kubernetes operator plane.
			"src":  "member.example@shikanime.studio",
			"deny": ["tag:k8s-operator:443"],
		},
		{
			// Members have no raw IP access to infra nodes (SSH is gated separately).
			"src":  "member.example@shikanime.studio",
			"deny": ["tag:machine:22"],
		},
		{
			// Members never reach the Automata control ports.
			"src":  "member.example@shikanime.studio",
			"deny": ["tag:automata:8642"],
		},
		{
			// Restricted tier (arr stack, sync, flux, webhook) is admin-only.
			"src":  "member.example@shikanime.studio",
			"deny": [
				"tag:automata:443",
				"tag:bazarr:443",
				"tag:flux-operator:443",
				"tag:flux-receivers:443",
				"tag:gitea-mirror:443",
				"tag:lidarr:443",
				"tag:maintainerr:443",
				"tag:metatube:443",
				"tag:prowlarr:443",
				"tag:syncthing:443",
				"tag:telsha-webhook:443",
				"tag:whisparr:443",
			],
		},
		{
			// Members cannot sync with Syncthing peers.
			"src":  "member.example@shikanime.studio",
			"deny": ["tag:syncthing:22000", "tag:syncthing:21027"],
		},

		// --- autogroup:it-admin path (stand-in: the owner identity) ---
		{
			// Admins reach the Kubernetes operator API.
			"src":    "shikanime.deva@gmail.com",
			"accept": ["tag:k8s-operator:443"],
		},
		{
			// Admins may SSH into infra nodes.
			"src":    "shikanime.deva@gmail.com",
			"accept": ["tag:machine:22"],
		},
		{
			// Admins reach the Automata control plane.
			"src":    "shikanime.deva@gmail.com",
			"accept": ["tag:automata:8642", "tag:automata:9900"],
		},
		{
			// Admins reach the restricted tier (arr stack, sync, flux, webhook).
			"src":    "shikanime.deva@gmail.com",
			"accept": [
				"tag:automata:443",
				"tag:bazarr:443",
				"tag:flux-operator:443",
				"tag:flux-receivers:443",
				"tag:gitea-mirror:443",
				"tag:lidarr:443",
				"tag:maintainerr:443",
				"tag:metatube:443",
				"tag:prowlarr:443",
				"tag:syncthing:443",
				"tag:telsha-webhook:443",
				"tag:whisparr:443",
			],
		},
		{
			// Admins may sync with Syncthing peers.
			"src":    "shikanime.deva@gmail.com",
			"accept": ["tag:syncthing:22000", "tag:syncthing:21027"],
		},

		// --- non-user / tag-based invariants ---
		{
			// Funnel-exposed public nodes stay isolated from internal services.
			"src":  "tag:web",
			"deny": ["tag:inference:443"],
		},
		{
			// Pods may not pivot into node SSH.
			"src":  "tag:k8s-node",
			"deny": ["tag:machine:22"],
		},
		{
			// Clusters must not initiate A2A into workstations. The merged
			// directional model (PR #1241) permits workstation->cluster only;
			// the app layer enforces this, and this deny is the network
			// backstop so a misconfig cannot open the reverse path.
			"src":  "tag:machine",
			"deny": ["tag:workstation:9900", "tag:workstation:8642"],
		},
		{
			// Every machine reaches the identity tier (Authelia OIDC, lldap
			// LDAP) on 443; nothing else on those nodes.
			"src":    "tag:machine",
			"accept": ["tag:authelia:443", "tag:lldap:443"],
			"deny":   ["tag:authelia:9091"],
		},
	],
}
